# Creator Discovery Tool — API Keys
# Copy this file to .env and fill in your keys

# ═══════════════════════════════════════════
# OPTION 1: Apify (RECOMMENDED for IG + TikTok)
# ═══════════════════════════════════════════
# Sign up: https://apify.com (free tier = $5/month credits)
# Get token: https://console.apify.com/account/integrations
# This single token powers both Instagram AND TikTok scraping
APIFY_TOKEN=

# ═══════════════════════════════════════════
# OPTION 2: RapidAPI (fallback for IG + TikTok)
# ═══════════════════════════════════════════
# Sign up: https://rapidapi.com
# Subscribe to these free-tier APIs:
#   Instagram: https://rapidapi.com/social-api1-instagram/api/instagram-scraper-api2
#   TikTok: https://rapidapi.com/tikwm-tikwm-default/api/tiktok-scraper7
RAPIDAPI_KEY=
# RAPIDAPI_IG_HOST=instagram-scraper-api2.p.rapidapi.com
# RAPIDAPI_TT_HOST=tiktok-scraper7.p.rapidapi.com

# ═══════════════════════════════════════════
# YouTube Data API v3 (FREE — 10,000 units/day)
# ═══════════════════════════════════════════
# 1. Go to https://console.cloud.google.com
# 2. Create a project (or use existing)
# 3. Enable "YouTube Data API v3"
# 4. Create an API key under Credentials
YOUTUBE_API_KEY=
